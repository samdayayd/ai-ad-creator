# Copy this file to ".env" and fill in your own Alpaca API keys.
# Get free paper-trading keys at https://app.alpaca.markets/ (Paper Trading tab).
# Live keys require a funded live brokerage account.

ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# "paper" (simulated money) or "live" (real money). Start with paper.
ALPACA_MODE=paper
