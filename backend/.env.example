# The app owner's account — created automatically on startup, on an
# unlimited plan. Everyone else signs up via the app itself (free/pro/max).
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=changeme123

# Signs JWT session tokens — set this to a long random string in production.
JWT_SECRET=dev-secret-change-me

# Required for ad generation. Get one at https://console.anthropic.com/.
# Every "Create ads" click makes one paid API call — there is no free tier
# for this feature, generating real ad copy needs a real model.
ANTHROPIC_API_KEY=

# Required only for the UGC Ad tab. Get one at https://elevenlabs.io/ — a
# separate paid account from the Anthropic key above, used for real neural
# voice synthesis.
ELEVENLABS_API_KEY=

# Required only for the UGC Ad tab. Get one at https://studio.d-id.com/ — a
# separate paid account, used to animate one of D-ID's own pre-licensed
# stock presenters. Often needs a paid plan, not just a free trial, before
# the API is usable.
D_ID_API_KEY=

# CORS — the frontend's own URL(s), comma-separated.
CORS_ORIGINS=http://localhost:3000

# The frontend's own URL — used to build Stripe Checkout/portal redirect
# links. Must be a real, reachable URL in production (not localhost).
FRONTEND_URL=http://localhost:3000

# Subscriptions (Pro/Max plans, watermark-free, higher video quotas). Get
# these at https://dashboard.stripe.com/ — a separate paid-processor
# account from every other key above. Leave all three unset to disable
# billing entirely: everyone stays on the free plan, checkout/portal return
# a clear "not set up" error instead of failing silently.
#   STRIPE_SECRET_KEY: your account's secret API key.
#   STRIPE_WEBHOOK_SECRET: from the webhook endpoint you register in the
#     Stripe dashboard pointing at POST /api/billing/webhook.
#   STRIPE_PRICE_ID_PRO / STRIPE_PRICE_ID_MAX: the Price IDs for the two
#     paid plans, created as recurring monthly Products in Stripe.
# IMPORTANT — read before going live with real payments (see README):
# this app's SQLite database has no persistent disk on Cloud Run/Render
# free tiers, so a paying customer's account could be wiped on a cold
# start. Point DATABASE_URL at a real Postgres instance (e.g. Cloud SQL)
# before accepting real subscriptions — psycopg2-binary is already in
# requirements.txt for exactly this.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAX=

# Contact form — relays visitor messages to your private inbox via SMTP.
# CONTACT_EMAIL is never exposed to the frontend/client. Works with any
# SMTP provider; simplest path if you don't want a new signup is Gmail +
# an App Password (myaccount.google.com/apppasswords — requires 2FA to be
# enabled on the Google account first). Leave any of these unset to
# disable the contact form: it returns a clear "not set up" error instead
# of failing silently.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_EMAIL=
