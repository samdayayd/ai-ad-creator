# Single owner login — this app has no public signup.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=changeme123

# Signs JWT session tokens — set this to a long random string in production.
JWT_SECRET=dev-secret-change-me

# Required for ad generation. Get one at https://console.anthropic.com/.
# Every "Create ads" click makes one paid API call — there is no free tier
# for this feature, generating real ad copy needs a real model.
ANTHROPIC_API_KEY=

# Required only for the UGC Ad tab. Get one at https://elevenlabs.io/ — a
# separate paid account from the Anthropic key above, used for real neural
# voice synthesis.
ELEVENLABS_API_KEY=

# Required only for the UGC Ad tab. Get one at https://studio.d-id.com/ — a
# separate paid account, used to animate one of D-ID's own pre-licensed
# stock presenters. Often needs a paid plan, not just a free trial, before
# the API is usable.
D_ID_API_KEY=

# CORS — the frontend's own URL(s), comma-separated.
CORS_ORIGINS=http://localhost:3000
